# Paths the agent never needs to read. Syntax follows .gitignore.
#
# Cursor already skips everything in .gitignore; this file adds paths that
# are tracked or useful to humans but only waste agent context.
#
# .cursor/hooks/guard-test-writes.py also reads this file and denies shell
# reads (cat, grep, sed, and so on) of the paths below. Lines starting with
# `#` or `!` are skipped by that hook, so negation patterns have no effect
# there.
#
# test-results/ is deliberately absent: the healer skill reads
# error-context.md from it.

# Lockfiles: large, generated, and never needed to write a test.
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# Build output and framework caches.
node_modules/
.next/
dist/
build/
out/
.turbo/
.vercel/

# Test reports and tool state. Read the test source instead.
coverage/
playwright-report/
blob-report/
.vitest/
.playwright-cli/
.playwright/
