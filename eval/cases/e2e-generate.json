{
  "id": "e2e-generate",
  "title": "Generate page classes and a spec from a plan",
  "skill": "qa-generate",
  "kind": "e2e",
  "server": "normal",
  "user": "/qa-generate Generate the Playwright spec from test/e2e/plan/sign-in.plan.md. This is UI. The app runs at {{BASE_URL}}.",
  "userOld": "/qa Generate the Playwright spec from test/e2e/plan/sign-in.plan.md. This is UI.",
  "setup": {
    "remove": [
      "test/e2e/sign-in.spec.ts",
      "test/e2e/pages/sign-in-page.ts",
      "test/e2e/pages/dashboard-page.ts"
    ],
    "edits": []
  },
  "expect": {
    "outcome": "pass",
    "file": "test/e2e/sign-in.spec.ts",
    "mayWrite": ["test/e2e/sign-in.spec.ts", "test/e2e/pages/*-page.ts"],
    "minTests": 6,
    "tests": [
      "Valid account reaches the dashboard",
      "Empty email is rejected",
      "Badly formatted email is rejected",
      "Password shorter than 8 characters is rejected",
      "Wrong password shows an error",
      "Server error shows a retry message"
    ],
    "content": [
      {
        "glob": "test/e2e/sign-in.spec.ts",
        "firstLine": "// spec: test/e2e/plan/sign-in.plan.md",
        "absent": ["page.getBy", "page.locator("],
        "why": "the spec names its plan on line 1, and locators belong in page classes"
      },
      {
        "glob": "test/e2e/pages/*-page.ts",
        "exists": true,
        "absent": ["expect("],
        "why": "there is at least one page class, and assertions belong in the spec"
      }
    ]
  },
  "reference": {
    "restore": [
      "test/e2e/sign-in.spec.ts",
      "test/e2e/pages/sign-in-page.ts",
      "test/e2e/pages/dashboard-page.ts"
    ],
    "edits": [],
    "reply": {
      "Plan": "test/e2e/plan/sign-in.plan.md",
      "Page classes": "test/e2e/pages/sign-in-page.ts, test/e2e/pages/dashboard-page.ts",
      "Spec": "test/e2e/sign-in.spec.ts",
      "Command": "RTK_DISABLED=1 BASE_URL={{BASE_URL}} npx playwright test test/e2e/sign-in.spec.ts",
      "Result": "QA-VERDICT: PASS (passed 6, failed 0, skipped 0, files 1)",
      "Verdict": "PASS",
      "Bug": "none"
    }
  }
}
