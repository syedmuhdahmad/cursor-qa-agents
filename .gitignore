# Dependencies
node_modules/

# Python bytecode from the Cursor hook and its tests
__pycache__/
*.pyc

# Next.js build output
.next/

# Test output and tool state.
# The four report folders start with a slash, so they match in the project
# root only. Vitest and Playwright write them next to their config files, which
# sit in the root. A folder of the same name deeper down, such as
# app/coverage/, is application source and stays visible to git.
.vitest/
/coverage/
/playwright-report/
/test-results/
/blob-report/
.playwright-cli/
.playwright/

# Page snapshots and console logs that the Playwright MCP server saves
.playwright-mcp/

# Maestro. By default it writes to ~/.maestro/tests, outside the repository.
# This folder appears only when a person passes --debug-output=.
.maestro/tests/
