{
  "name": "qa-agent-kit",
  "description": "Cursor agent setup for writing and fixing tests: skills for Vitest, Playwright, and Maestro, and a guardrail hook that denies the agent's direct edits to application source.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedmuhdahmad/qa-agent-kit.git"
  },
  "bugs": "https://github.com/syedmuhdahmad/qa-agent-kit/issues",
  "homepage": "https://github.com/syedmuhdahmad/qa-agent-kit#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:hook": "python3 -m unittest discover -s .cursor/hooks",
    "test:reporters": "node --test \".cursor/qa/*.test.mjs\"",
    "test:audit-skill": "node --test \".cursor/skills/security-audit/*.test.cjs\"",
    "lint:md": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "check:playwright-cli-skill": "node scripts/ci/playwright-cli-skill.mjs",
    "check:security-audit-skill": "node scripts/ci/security-audit-skill.mjs"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "smol-toml": "1.9.1",
    "katex": "0.18.11",
    "markdown-it": "15.0.3"
  }
}
